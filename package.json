{
  "name": "cutterstudio-pro",
  "productName": "CutterStudio Pro",
  "version": "1.1.0",
  "description": "aisac vinyl cutter & plotter studio for Windows and Linux",
  "main": "electron/main.js",
  "author": "aisac",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "preview": "python3 -m http.server 8080 --bind 0.0.0.0 --directory app",
    "test": "node tests/verify.js && node tests/engine.test.js && node tests/image-prep.test.js && node tests/features.test.js && node tests/kit.test.js && node tests/fonts.test.js && node tests/seo.test.js",
    "pack:win": "electron-builder --win --x64",
    "pack:linux": "electron-builder --linux --x64",
    "pack": "electron-builder --win --linux --x64"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aisac.cutterstudio",
    "productName": "CutterStudio Pro",
    "files": [
      "app/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "CutterStudio-Pro-${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Graphics",
      "maintainer": "aisac",
      "desktop": {
        "Name": "CutterStudio Pro",
        "Comment": "Vinyl cutter and plotter studio",
        "StartupWMClass": "cutterstudio-pro"
      },
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "artifactName": "CutterStudio-Pro-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
